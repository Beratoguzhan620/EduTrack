<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="Partials/Layout/_Head" />
    <title>@ViewData["Title"] · EduTrack</title>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="Partials/Layout/_Navbar" />

    <div class="app-body">
        <partial name="Partials/Layout/_Sidebar" />

        <main class="app-main" id="main">
            <div class="app-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="false"></div>
    <partial name="Partials/_ConfirmModal" />

    <partial name="Partials/Layout/_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
