@using EduTrack.Web.Models.Course
@model CourseDetailViewModel
@{
    ViewData["Title"] = "Students";
}

<main class="py-4">
    <partial name="Partials/_CourseHeaderPartial" model="Model.CourseDetail" />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="page-title h2 mb-1">Students</h1>
            <p class="text-secondary mb-0">Computer Science 101 roster.</p>
        </div><button class="btn btn-success">Invite student</button>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Assignments complete</th>
                        <th>Average</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Maya Singh</td>
                        <td>maya.student@edutrack.test</td>
                        <td>9 / 10</td>
                        <td>91%</td>
                        <td><span class="badge text-bg-success">Active</span></td>
                    </tr>
                    <tr>
                        <td>Owen Lee</td>
                        <td>owen.lee@edutrack.test</td>
                        <td>10 / 10</td>
                        <td>95%</td>
                        <td><span class="badge text-bg-success">Active</span></td>
                    </tr>
                    <tr>
                        <td>Leila Carter</td>
                        <td>leila.carter@edutrack.test</td>
                        <td>7 / 10</td>
                        <td>84%</td>
                        <td><span class="badge text-bg-warning">Needs support</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</main>