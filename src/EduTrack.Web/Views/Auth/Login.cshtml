@using EduTrack.Application.DTOs.Auth
@model LoginRequest
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Giriş yap";
}

<h1>Tekrar hoş geldiniz</h1>
<p class="lead-text">Derslerinize devam etmek için hesabınıza giriş yapın.</p>

<partial name="Partials/_ErrorMessageAlert" />
<partial name="Partials/_SuccessMessageAlert" />

<form method="post" asp-action="Login" asp-controller="Auth" novalidate>
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

    <div class="mb-3">
        <label class="form-label" asp-for="Email">E-posta</label>
        <input class="form-control" asp-for="Email" type="email" autocomplete="email" placeholder="ornek@okul.com" autofocus />
        <span asp-validation-for="Email"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Password">Şifre</label>
        <div class="password-field">
            <input class="form-control" asp-for="Password" id="passwordInput" autocomplete="current-password" />
            <button class="password-toggle" type="button" data-password-toggle="passwordInput" aria-label="Şifreyi göster" tabindex="-1">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="RememberMe" type="checkbox" class="form-check-input" id="rememberMeCheck" />
        <label class="form-check-label small" for="rememberMeCheck">Beni hatırla</label>
    </div>

    <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
</form>

<p class="auth-switch">
    Hesabınız yok mu? <a asp-action="Register" asp-controller="Auth">Kayıt olun</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
