@using EduTrack.Domain.Enums
@using EduTrack.Web.Models.Course
@using EduTrack.Web.Models.Shared
@model CourseDetailViewModel
@{
    ViewData["Title"] = $"Materyaller · {Model.CourseDetail.Title}";
    var isInstructor = Model.CourseDetail.IsInstructor;

    (string Text, string Icon) Describe(MaterialType type) => type switch
    {
        MaterialType.Document => ("Doküman", "bi-file-earmark-text"),
        MaterialType.Link => ("Bağlantı", "bi-link-45deg"),
        _ => ("Metin", "bi-card-text"),
    };
}

<partial name="Partials/_ErrorMessageAlert" />
<partial name="Partials/_SuccessMessageAlert" />

<partial name="Partials/_CourseHeaderPartial" model="Model.CourseDetail" />

<div class="section-header">
    <div>
        <h2>Materyaller</h2>
        <p>@(isInstructor ? "Ders notları, dokümanlar ve bağlantılar. Eklediğiniz her materyal akışta da paylaşılır." : "Eğitmeninizin paylaştığı ders kaynakları.")</p>
    </div>
    @if (isInstructor)
    {
        <a class="btn btn-primary" asp-action="Add" asp-controller="Materials" asp-route-id="@Model.CourseDetail.Id"><i class="bi bi-plus-lg"></i>Materyal ekle</a>
    }
</div>

@if (Model.Materials.Count == 0)
{
    <partial name="Partials/_EmptyState" model="@(new EmptyStateViewModel(
        "Henüz materyal yok",
        isInstructor ? "Ders notu, doküman veya bağlantı ekleyerek başlayın." : "Eğitmeniniz materyal paylaştığında burada listelenir.",
        "bi-folder2-open")
    {
        ActionText = isInstructor ? "Materyal ekle" : null,
        ActionUrl = isInstructor ? Url.Action("Add", "Materials", new { id = Model.CourseDetail.Id }) : null,
    })" />
}
else
{
    <div class="material-list">
        @foreach (var material in Model.Materials)
        {
            var (text, icon) = Describe(material.Type);
            <a class="material-item" asp-action="Details" asp-controller="Materials" asp-route-id="@material.Id"
               target="@(material.Type == MaterialType.Content ? null : "_blank")" rel="@(material.Type == MaterialType.Content ? null : "noopener")">
                <span class="material-icon"><i class="bi @icon"></i></span>
                <span class="material-body">
                    <span class="material-title">@material.Title</span>
                    @if (!string.IsNullOrWhiteSpace(material.Description))
                    {
                        <span class="material-description">@material.Description</span>
                    }
                </span>
                <span class="material-meta">
                    <span class="badge badge-neutral">@text</span>
                    <span class="text-muted small">@material.Date.ToLocalTime().ToString("d MMM")</span>
                </span>
            </a>
        }
    </div>
}
