# Copy to .env and fill in real values. Never commit .env.

# SQL Server
ConnectionStrings__DefaultConnection=Server=(localdb)\\MSSQLLocalDB;Database=EduTrackDb;Trusted_Connection=True;TrustServerCertificate=True;

# File API (external-services/FileAPI)
FileApi__BaseUrl=http://localhost:5099/
FileApi__ApiKey=change-me

# Optional: where ASP.NET Core data-protection keys are stored
# DataProtection__KeysPath=/app/data-protection-keys
