@using EduTrack.Application.DTOs.Course
@model CourseDto

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, params string[] actions) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && actions.Any(a => string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase));

    var tabs = new (string Text, string Action, string Icon, bool Active)[]
    {
        ("Akış", "Detail", "bi-chat-square-text", IsActive("Course", "Detail")),
        ("Materyaller", "Materials", "bi-folder2-open", IsActive("Course", "Materials") || IsActive("Materials", "Details", "Add")),
        ("Ödevler", "Assignments", "bi-clipboard-check", IsActive("Course", "Assignments") || IsActive("Assignments", "Detail")),
        ("Öğrenciler", "Students", "bi-people", IsActive("Course", "Students")),
    };
}

<section class="course-hero @(Model.IsInstructor ? "course-banner-instructor" : "course-banner")">
    <div>
        <h1>@Model.Title</h1>
        <p>@Model.InstructorFullName · @Model.StudentCount öğrenci</p>
    </div>
    @if (Model.IsInstructor && !string.IsNullOrEmpty(Model.Code))
    {
        <div class="course-code-box course-code-box-inverse">
            <span class="course-code-label">Ders kodu</span>
            <span class="course-code-value">@Model.Code</span>
            <button type="button" class="course-code-copy-btn" data-copy-code="@Model.Code" aria-label="Ders kodunu kopyala"><i class="bi bi-copy"></i></button>
        </div>
    }
</section>

<nav class="course-tabs" aria-label="Ders bölümleri">
    @foreach (var tab in tabs)
    {
        <a class="course-tab@(tab.Active ? " active" : "")" aria-current="@(tab.Active ? "page" : null)"
           asp-controller="Course" asp-action="@tab.Action" asp-route-id="@Model.Id">
            <i class="bi @tab.Icon"></i>@tab.Text
        </a>
    }
</nav>
