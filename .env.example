# Copy to .env and fill in real values. Never commit .env.

# SQL Server
ConnectionStrings__DefaultConnection=Server=(localdb)\\MSSQLLocalDB;Database=EduTrackDb;Trusted_Connection=True;TrustServerCertificate=True;

# Password for admin@example.com, created on first start
Admin__Password=change-me

# Adds the demo classroom (teacher, students, courses) on first start
# Seed__DemoContent=true

# File API (external-services/FileAPI)
FileApi__BaseUrl=http://localhost:5099/
FileApi__ApiKey=change-me
# Address browsers use for uploaded files, when it differs from BaseUrl (e.g. behind Docker)
# FileApi__PublicUrl=http://localhost:8081/

# Optional: where ASP.NET Core data-protection keys are stored
# DataProtection__KeysPath=/app/data-protection-keys

# SMTP for verification e-mails (leave Host empty to log e-mails instead)
# Email__Host=smtp.gmail.com
# Email__Username=you@gmail.com
# Email__Password=<app password>
# Email__FromAddress=you@gmail.com
