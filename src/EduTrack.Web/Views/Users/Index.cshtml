@using EduTrack.Domain.Constants
@using EduTrack.Web.Models.Shared
@using EduTrack.Web.Models.Users
@model GetUsersViewModel
@{
    ViewData["Title"] = "Kullanıcılar";
    var users = Model.Response?.Items ?? [];
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Query.Search) || Model.Query.RoleId is not null;

    string RoleLabel(string role) => role switch
    {
        RoleConstants.Admin => "Yönetici",
        RoleConstants.Instructor => "Eğitmen",
        _ => role,
    };
}

<partial name="Partials/_SuccessMessageAlert" />

<partial name="Partials/_PageHeader" model="@(new PageHeaderViewModel("Kullanıcılar", "Hesapları görüntüleyin, rollerini ve durumlarını yönetin."))" />

<div class="card">
    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 p-3 border-bottom">
        <div class="position-relative flex-grow-1" style="min-width: 220px">
            <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 12px"></i>
            <input class="form-control ps-5" placeholder="Ad, soyad veya e-posta ara" asp-for="Query.Search" aria-label="Kullanıcı ara" />
        </div>
        <select class="form-select w-auto" style="min-width: 150px" asp-for="Query.RoleId" onchange="this.form.submit()" aria-label="Role göre filtrele">
            <option value="">Tüm roller</option>
            @foreach (var role in RoleConstants.BaseRoles)
            {
                <option value="@role.Id">@RoleLabel(role.Name)</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
        @if (hasFilter)
        {
            <a class="btn btn-ghost" asp-action="Index">Temizle</a>
        }
    </form>

    @if (users.Count == 0)
    {
        <div class="p-3">
            <partial name="Partials/_EmptyState" model="@(new EmptyStateViewModel(
                hasFilter ? "Sonuç bulunamadı" : "Henüz kullanıcı yok",
                hasFilter ? "Arama ifadesini veya rol filtresini değiştirip tekrar deneyin." : "Kayıt olan kullanıcılar burada listelenir.",
                "bi-people"))" />
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Ad soyad</th>
                        <th>E-posta</th>
                        <th>Roller</th>
                        <th>Durum</th>
                        <th class="text-end"><span class="visually-hidden">İşlemler</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar">@($"{user.FirstName.FirstOrDefault()}{user.LastName.FirstOrDefault()}".ToUpperInvariant())</span>
                                    <span class="fw-medium">@user.FirstName @user.LastName</span>
                                </div>
                            </td>
                            <td class="text-muted">@user.Email</td>
                            <td>
                                @if (user.UserRoles is { Count: > 0 })
                                {
                                    foreach (var role in user.UserRoles)
                                    {
                                        <span class="badge badge-accent me-1">@RoleLabel(role.RoleName)</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge badge-neutral">Öğrenci</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge badge-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@user.Id">
                                    <i class="bi bi-pencil"></i>Düzenle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Response is not null)
    {
        <partial name="Partials/_Pagination" model="@(new PaginationViewModel(Model.Response.Index, Model.Response.Pages, Model.Response.Count, Model.Response.Size) { PageParameter = "Query.Index" })" />
    }
</div>
