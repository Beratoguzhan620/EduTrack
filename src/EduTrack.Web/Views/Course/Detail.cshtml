@using EduTrack.Application.DTOs.StreamPost
@using EduTrack.Domain.Enums
@using EduTrack.Web.Models.Course
@using EduTrack.Web.Models.Shared
@model CourseDetailViewModel
@{
    ViewData["Title"] = Model.CourseDetail.Title;
    var isInstructor = Model.CourseDetail.IsInstructor;
}

<partial name="Partials/_ErrorMessageAlert" />
<partial name="Partials/_SuccessMessageAlert" />

<partial name="Partials/_CourseHeaderPartial" model="Model.CourseDetail" />

<div class="row g-4">
    <div class="col-lg-8 order-2 order-lg-1">
        @if (isInstructor)
        {
            <form class="card mb-4" method="post" asp-action="MakeAnnouncement" asp-controller="Course" asp-route-id="@Model.CourseDetail.Id">
                <div class="card-body">
                    <label class="form-label" for="announcement">Sınıfınızla paylaşın</label>
                    <textarea id="announcement" name="content" class="form-control mb-3" rows="3" maxlength="@CourseController.AnnouncementMaxLength" required placeholder="Bir duyuru yazın…"></textarea>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i>Paylaş</button>
                    </div>
                </div>
            </form>
        }

        @if (Model.StreamPosts.Count == 0)
        {
            <partial name="Partials/_EmptyState" model="@(new EmptyStateViewModel(
                "Akışta henüz paylaşım yok",
                isInstructor ? "Duyurular, materyaller ve ödevler burada zaman sırasıyla görünür." : "Eğitmeniniz duyuru, materyal veya ödev paylaştığında burada görünecek.",
                "bi-chat-square-text"))" />
        }
        else
        {
            <ol class="stream-list">
                @foreach (var post in Model.StreamPosts)
                {
                    <li class="stream-post">
                        <span class="avatar">@post.InstructorInitials</span>
                        <div class="stream-post-body">
                            <div class="stream-post-head">
                                <span class="fw-medium">@post.Title</span>
                                <time class="text-muted small" datetime="@post.Date.ToString("o")">@post.Date.ToLocalTime().ToString("d MMMM, HH:mm")</time>
                            </div>
                            @switch (post.Type)
                            {
                                case StreamPostType.Material:
                                    <a class="stream-attachment" asp-action="Details" asp-controller="Materials" asp-route-id="@post.Content">
                                        <i class="bi bi-folder2-open"></i><span>Materyali aç</span>
                                    </a>
                                    break;
                                case StreamPostType.Assignment:
                                    <a class="stream-attachment" asp-action="Detail" asp-controller="Assignments" asp-route-id="@post.Content">
                                        <i class="bi bi-clipboard-check"></i><span>Ödevi aç</span>
                                    </a>
                                    break;
                                default:
                                    <p class="stream-text">@post.Content</p>
                                    break;
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </div>

    <aside class="col-lg-4 order-1 order-lg-2">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h6 text-muted mb-2">Ders hakkında</h2>
                <p class="mb-3">@(string.IsNullOrWhiteSpace(Model.CourseDetail.Description) ? "Açıklama eklenmemiş." : Model.CourseDetail.Description)</p>
                <dl class="detail-list mb-0">
                    <dt>Eğitmen</dt><dd>@Model.CourseDetail.InstructorFullName</dd>
                    <dt>Öğrenci</dt><dd class="font-mono">@Model.CourseDetail.StudentCount</dd>
                </dl>
            </div>
        </div>
    </aside>
</div>
