@using EduTrack.Application.DTOs.Auth
@model RegisterRequest
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Kayıt ol";
}

<h1>Hesap oluşturun</h1>
<p class="lead-text">Birkaç bilgiyle kaydolun, ardından ders kodunuzla derslere katılın.</p>

<partial name="Partials/_ErrorMessageAlert" />

<form method="post" asp-action="Register" asp-controller="Auth" novalidate>
    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label class="form-label" asp-for="FirstName">Ad</label>
            <input class="form-control" asp-for="FirstName" autocomplete="given-name" autofocus />
            <span asp-validation-for="FirstName"></span>
        </div>
        <div class="col-sm-6">
            <label class="form-label" asp-for="LastName">Soyad</label>
            <input class="form-control" asp-for="LastName" autocomplete="family-name" />
            <span asp-validation-for="LastName"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Email">E-posta</label>
        <input class="form-control" asp-for="Email" type="email" autocomplete="email" placeholder="ornek@okul.com" />
        <span asp-validation-for="Email"></span>
    </div>

    <div class="mb-4">
        <label class="form-label" asp-for="Password">Şifre</label>
        <div class="password-field">
            <input class="form-control" asp-for="Password" id="registerPassword" autocomplete="new-password" aria-describedby="passwordHelp" />
            <button class="password-toggle" type="button" data-password-toggle="registerPassword" aria-label="Şifreyi göster" tabindex="-1">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <div class="form-text" id="passwordHelp">En az 6 karakter.</div>
        <span asp-validation-for="Password"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Kayıt ol</button>
</form>

<p class="auth-switch">
    Zaten hesabınız var mı? <a asp-action="Login" asp-controller="Auth">Giriş yapın</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
