@using EduTrack.Application.DTOs.Course
@using EduTrack.Application.DTOs.CourseMaterial
@model CourseMaterialDto
@{
    ViewData["Title"] = Model.Title;
    var course = ViewBag.Course as CourseDto;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Course" asp-action="Index">Dersler</a></li>
        <li class="breadcrumb-item"><a asp-controller="Course" asp-action="Materials" asp-route-id="@Model.CourseId">@(course?.Title ?? "Materyaller")</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<article class="card form-card">
    <div class="card-body p-4">
        <span class="badge badge-neutral mb-2"><i class="bi bi-card-text me-1"></i>Metin</span>
        <h1 class="h4 mb-1">@Model.Title</h1>
        <p class="text-muted small mb-4">@Model.Date.ToLocalTime().ToString("d MMMM yyyy, HH:mm")</p>

        @if (string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted mb-0">Bu materyale içerik eklenmemiş.</p>
        }
        else
        {
            <div class="instructions">@Model.Description</div>
        }

        <a class="btn btn-outline-secondary mt-4" asp-controller="Course" asp-action="Materials" asp-route-id="@Model.CourseId"><i class="bi bi-arrow-left"></i>Materyallere dön</a>
    </div>
</article>
