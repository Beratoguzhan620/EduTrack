@using EduTrack.Application.DTOs.Course
@model CourseDto

<div class="card h-100">
    <div class="@(Model.IsInstructor ? "course-banner-instructor" : "course-banner") p-4">
        <h2 class="h5 mb-1">@Model.Title</h2>
        <p class="mb-0 small">@Model.InstructorFullName</p>
    </div>

    <div class="card-body d-flex flex-column">
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted small">@Model.Description</p>
        }

        <div class="d-flex flex-wrap align-items-center gap-2 mt-auto">
            <span class="badge badge-neutral"><i class="bi bi-people me-1"></i>@Model.StudentCount öğrenci</span>

            @if (Model.IsInstructor)
            {
                <div class="course-code-box">
                    <span class="course-code-label">Kod</span>
                    <span class="course-code-value">@Model.Code</span>
                    <button type="button" class="course-code-copy-btn" data-copy-code="@Model.Code" aria-label="Ders kodunu kopyala" title="Kopyala">
                        <i class="bi bi-copy"></i>
                    </button>
                </div>
            }

            <a asp-action="Detail" asp-controller="Course" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm ms-auto">
                Dersi aç<i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
