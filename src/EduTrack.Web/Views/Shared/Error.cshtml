@using EduTrack.Web.Models.Shared
@model ErrorViewModel
@{
    ViewData["Title"] = "Bir hata oluştu";
}

<div class="status-page">
    <partial name="Partials/_EmptyState" model="@(new EmptyStateViewModel(
        "Bir şeyler ters gitti",
        "İsteğiniz işlenirken beklenmeyen bir hata oluştu. Sayfayı yenileyin ya da biraz sonra tekrar deneyin.",
        "bi-exclamation-triangle")
    {
        ActionText = "Derslere dön",
        ActionUrl = Url.Action("Index", "Course"),
    })" />
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="text-center text-muted small mt-3">Hata kodu: <span class="font-mono">@Model.RequestId</span></p>
    }
</div>
