@using EduTrack.Domain.Constants
@using EduTrack.Web.Models.Course
@using EduTrack.Web.Models.Shared
@using Microsoft.AspNetCore.Html
@model CourseViewModel
@{
    ViewData["Title"] = "Dersler";
}

@{
    var canCreate = User.IsInRole(RoleConstants.Admin) || User.IsInRole(RoleConstants.Instructor);

    Func<object?, IHtmlContent> headerActions = @<text>
        <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#joinCourse">
            <i class="bi bi-box-arrow-in-right"></i>Derse katıl
        </button>
        @if (canCreate)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCourse">
                <i class="bi bi-plus-lg"></i>Ders oluştur
            </button>
        }
    </text>;
}

<partial name="Partials/_ErrorMessageAlert" />
<partial name="Partials/_SuccessMessageAlert" />

<partial name="Partials/_PageHeader" model="@(new PageHeaderViewModel(
    canCreate ? "Dersler" : "Derslerim",
    canCreate ? "Verdiğiniz ve katıldığınız dersler." : "Katıldığınız dersler. Yeni bir derse ders koduyla katılabilirsiniz.")
{
    Actions = headerActions,
})" />

@if (Model.Courses.Count == 0)
{
    <partial name="Partials/_EmptyState" model="@(new EmptyStateViewModel(
        "Henüz bir dersiniz yok",
        canCreate
            ? "İlk dersinizi oluşturun, ardından ders kodunu öğrencilerinizle paylaşın."
            : "Eğitmeninizden aldığınız ders koduyla bir derse katılın.",
        "bi-journal-bookmark")
    {
        ActionText = canCreate ? "Ders oluştur" : "Derse katıl",
        ActionModalTarget = canCreate ? "#createCourse" : "#joinCourse",
    })" />
}
else
{
    <div class="row g-4">
        @foreach (var course in Model.Courses)
        {
            <div class="col-md-6 col-xl-4">
                <partial name="Partials/_CourseCardPartial" model="course" />
            </div>
        }
    </div>
}


<div class="modal fade" id="createCourse" tabindex="-1" aria-labelledby="createCourseTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" asp-action="Create" asp-controller="Course" method="post" novalidate>
            <div class="modal-header">
                <h2 class="modal-title h5" id="createCourseTitle">Ders oluştur</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" asp-for="CreateCourseViewModel!.Title"></label>
                    <input class="form-control" placeholder="Ör. 5-A Matematik" asp-for="CreateCourseViewModel!.Title" maxlength="100" />
                    <span asp-validation-for="CreateCourseViewModel!.Title"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="CreateCourseViewModel!.Description"></label>
                    <textarea class="form-control" rows="3" placeholder="Öğrencilerin dersi tanıyacağı kısa bir açıklama" asp-for="CreateCourseViewModel!.Description" maxlength="500"></textarea>
                    <span asp-validation-for="CreateCourseViewModel!.Description"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="submit" class="btn btn-primary">Dersi oluştur</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="joinCourse" tabindex="-1" aria-labelledby="joinCourseTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" asp-action="Join" asp-controller="Course" method="post" novalidate>
            <div class="modal-header">
                <h2 class="modal-title h5" id="joinCourseTitle">Derse katıl</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" asp-for="JoinCourseViewModel!.Code"></label>
                <input class="form-control font-mono text-uppercase" placeholder="8 karakterlik kod" asp-for="JoinCourseViewModel!.Code" maxlength="8" autocomplete="off" />
                <div class="form-text">Kodu eğitmeninizden alabilirsiniz.</div>
                <span asp-validation-for="JoinCourseViewModel!.Code"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="submit" class="btn btn-primary">Katıl</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
